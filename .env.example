# Copia este archivo a .env.local y completa los valores (Supabase > Project Settings > API).
# Solo van claves PÚBLICAS. Nunca pongas aquí la clave service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-clave-anon-publica

# URL pública donde se despliega la app (sin barra final). Se usa para armar el enlace del QR.
# En local: http://localhost:5173 — En producción: https://mi-aplicacion.vercel.app
VITE_PUBLIC_APP_URL=http://localhost:5173

# Opcional: texto con lugar y fecha de entrega que se muestra en cada cupón.
# VITE_PICKUP_INFO=Entrega: viernes 15:00, Facultad de Ingeniería, puerta principal
