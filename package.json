{
  "name": "cupones-qr",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "supabase start -x mailpit,imgproxy,vector,logflare,studio,postgres-meta",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db && bash supabase/tests/concurrencia.sh",
    "dev:cloud": "vite --mode cloud",
    "test:integration": "bash scripts/test-integration.sh",
    "test:all": "npm test && npm run db:test && npm run test:integration"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@yudiel/react-qr-scanner": "^2.6.0",
    "barcode-detector": "3.2.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
